# --- Dev / local (default ports on host) ---
DB_HOST_PORT=5433
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=3000

VITE_PROXY_TARGET=http://backend:8000
CORS_ALLOW_ALL=true

# --- Secrets (change on any shared or production host) ---
POSTGRES_USER=stashiq
POSTGRES_PASSWORD=stashiq
POSTGRES_DB=stashiq
# Optional override if the password has URL-special characters (@, :, etc.)
# DATABASE_URL=postgresql://stashiq:yourpassword@db:5432/stashiq
JWT_SECRET=dev-change-me-in-production

# Public hostname for bin QR deep links and invite emails
# Scheme optional — https is added if missing
PUBLIC_URL=https://stashiq.wewantthefunk.top
FRONTEND_BASE_URL=https://stashiq.wewantthefunk.top

# Local / LAN (set automatically by ./scripts/compose-up.sh — not for production compose-prod)
# LAN_IP=192.168.1.11
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.11:3000,https://stashiq.wewantthefunk.top

# --- Production (self-host + Cloudflare tunnel, e.g. 192.168.1.6) ---
# Start:  ./scripts/compose-prod.sh up --build -d
# Tunnel: cloudflared → http://127.0.0.1:3000 for stashiq.wewantthefunk.top
#
# FRONTEND_HOST_PORT=3000
# BACKEND_HOST_PORT=127.0.0.1:8001
# DB_HOST_PORT=127.0.0.1:5433
# PUBLIC_URL=https://stashiq.wewantthefunk.top
# FRONTEND_BASE_URL=https://stashiq.wewantthefunk.top
# CORS_ALLOW_ALL=false
# CORS_ORIGINS=https://stashiq.wewantthefunk.top,http://192.168.1.6:3000
# POSTGRES_PASSWORD=<strong>
# JWT_SECRET=<openssl rand -hex 32>

# Invite + password reset email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@wewantthefunk.top
# SMTP_USE_TLS=true
